{
  "agents": {
    "defaults": {
      "model": {
        "primary": "ollama/qwen3:8b"
      },
      "heartbeat": {
        "every": "0m"
      }
    },
    "entries": {
      "main": {
        "identity": {
          "name": "dopenclaw",
          "theme": "private personal assistant"
        }
      }
    }
  },
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434"
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "tailnet",
    "auth": {
      "mode": "token",
      "token": "__GATEWAY_TOKEN__"
    }
  },
  "update": {
    "checkOnStart": false
  },
  "memory": {
    "search": {
      "provider": "none"
    }
  },
  "plugins": {
    "allow": [
      "ollama",
      "memory-core",
      "browser",
      "device-pair",
      "bonjour",
      "daily-briefing",
      "kuleuven-library",
      "clipper"
    ],
    "entries": {
      "daily-briefing": {
        "enabled": true,
        "config": {
          "eventLeadMinutes": 15,
          "briefingTime": "08:00"
        }
      },
      "kuleuven-library": {
        "enabled": true,
        "config": {
          "reminderLeadMinutes": 30,
          "autoCheckin": true
        }
      },
      "clipper": {
        "enabled": true,
        "config": {
          "postingTimes": [
            "12:00",
            "17:00",
            "21:00"
          ],
          "clipsPerStreamer": 3,
          "clipSeconds": 45,
          "twitch": {
            "clientId": "",
            "clientSecret": ""
          },
          "youtube": {
            "clientId": "",
            "clientSecret": "",
            "redirectUri": "http://localhost:8765/callback"
          },
          "tiktok": {
            "clientKey": "",
            "clientSecret": "",
            "redirectUri": ""
          },
          "instagram": {
            "appId": "",
            "appSecret": "",
            "redirectUri": ""
          }
        }
      }
    }
  }
}
